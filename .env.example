NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DROPBOX_BASE_URL=

# Envio automático de e-mail (módulo Solicitações)
# Gmail: use uma "senha de app" (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Segredo usado para assinar o cookie de sessão das APIs (obrigatório com Supabase configurado)
AUTH_SESSION_SECRET=
# Hash scrypt da senha de emergência do admin primário (opcional; sem ela o fallback fica desativado)
PRIMARY_ADMIN_PASSWORD_HASH=
# "true" permite semear os usuários iniciais quando a tabela auth_users está vazia (use apenas em dev/primeira carga)
AUTH_USERS_ALLOW_SEED=
